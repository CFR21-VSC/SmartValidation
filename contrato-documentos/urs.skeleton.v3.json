  "fasesDeAdopcion": {
    "_nota": "La adopcion del contrato tiene DOS fases separadas. Confundirlas fue el error de la primera propuesta.",
    "fase1_aditiva": {
      "estado": "propuesta, verificable hoy",
      "cambia": "SOLO agrega id, clase y padre a cada elemento. No toca tipo, titulo, filas ni ningun campo existente.",
      "compatibilidad": "El renderer y el numerador actuales, que no conocen clase ni padre, producen EXACTAMENTE la misma salida. Verificado con contrato-documentos/numeracion-test.cjs sobre URS y VP reales.",
      "habilita": "Identidad estable por elemento, jerarquia explicita, y validacion de arbol/IDs/obligatoriedad."
    },
    "fase2_numeracion_derivada": {
      "estado": "NO aplicada",
      "cambia": "Quita el numero manual del titulo de las subsecciones y deriva la numeracion del arbol.",
      "requiere": "Un renderer consciente del contrato. Con el renderer actual la numeracion se corre (en el VP, el item 27 pasaba de 14 a 19).",
      "precondicion": "No migrar datos a fase 2 hasta tener ese renderer y una proyeccion legacy probada."
    },
    "precedencia_de_numeracion": {
      "_nota": "Mientras coexistan ambas fases, la regla es explicita y no ambigua:",
      "orden": [
        "numero entero en la instancia (fija y resincroniza)",
        "numero null (suprime)",
        "fase 2: derivada del arbol",
        "fase 1 / legacy: contador por titulo, subseccion no consume"
      ],
      "limite": "Con overrides enteros presentes, 'no puede haber saltos' NO es una garantia del sistema: es responsabilidad de quien los escribe. La validacion los reporta, no los corrige."
    }
  },
  "inmutable": true,
  "_nota": "Artefacto INMUTABLE. Un cambio publica 3.1; nunca se edita esta version. Las instancias lo referencian por {tipo, version}.",
  "compatibilidad": {
    "campoTipoEnInstancia": "type",
    "_nota": "Se conserva `type` (no `tipoDocumento`) porque es el que ya leen document-renderer.js y los 11 extractores Python. Introducir un alias obligaria a tocarlos sin ganancia.",
    "formaDeInstancia": "sin cambios respecto de v1/v2",
    "reglasDeForma": [
      "`filas` vive en la seccion (sec.filas), NUNCA bajo sec.tabla: tracer.py y coherence_pack.py leen sec.get('filas').",
      "Las filas de tablas con IDs son ARRAYS: tracer._extract_urs_rows descarta filas que no sean list.",
      "Las celdas pueden ser string u objeto rico; ambos extractores ya resuelven el texto (_text/_cell).",
      "PROHIBIDO fila-objeto con ID rico: coherence_pack._ids_urs hace str(fila['ursId']) y un dict no matchea el regex."
    ],
    "camposDesconocidos": {
      "politica": "preservar",
      "_nota": "Nunca se descarta un campo no reconocido. El nivel de diagnostico lo fija la version del contrato de la instancia, no una fecha global."
    }
  },
  "idPolicy": {
    "definidosAqui": [
      "URS",
      "URS-NF"
    ],
    "patrones": {
      "URS": "^URS-[0-9]{3,4}$",
      "URS-NF": "^URS-NF-[0-9]{3,4}$"
    },
    "prohibidos": [
      "URS-000",
      "URS-NF-000"
    ],
    "_notaRango": "3 o 4 digitos. Aceptar URS-1000 NO reescribe ni invalida los URS-001 ya firmados: solo amplia el conjunto admitido hacia adelante.",
    "valorSemantico": "Si la celda es objeto, el valor validado es celda.text; si es string, el string. La validacion NUNCA opera sobre el objeto serializado.",
    "unicidad": {
      "alcance": "proyecto + conjunto de revisiones vigentes",
      "_nota": "URS-001 es la MISMA identidad a traves de revisiones sucesivas del mismo documento. La unicidad no se aplica al archivo historico completo.",
      "distingue": {
        "definicion": "la fila que crea el ID",
        "referencia": "menciones desde FRS/RA/TC"
      }
    },
    "anchoMinimo": 3,
    "_notaCanonica": "Los patrones admiten 3 o 4 digitos para que URS-1000 sea posible. Eso deja dos grafias para el mismo numero (URS-001 y URS-0001), que aguas abajo son dos identidades. La forma canonica es: ceros a la izquierda solo hasta anchoMinimo."
  },
  "numeracion": {
    "origen": "derivada del arbol (clase + padre + orden)",
    "numeroEnInstancia": {
      "entero": "admitido: fija y resincroniza el contador",
      "null": "admitido: no numera",
      "string": "RECHAZADO en contrato 3.0",
      "_notaLegacy": "Documentos <3.0 conservan su interpretacion historica (el string se ignora y cae al contador). No se coerciona: un `numero: \"9\"` que hoy muestra 1 pasaria a mostrar 9 y cambiaria el render de un documento existente."
    }
  },
