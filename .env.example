# ═══════════════════════════════════════════════════════════════════════════
#  SMART Validation — Variables de Entorno
#  Copiá este archivo a .env para desarrollo local.
#  En Railway: configurar estas variables en el panel de Variables.
# ═══════════════════════════════════════════════════════════════════════════

# ── Servidor ─────────────────────────────────────────────────────────────────
# Railway inyecta PORT automáticamente — no hace falta setearlo.
# PORT=8080

# Modo de entorno. "production" activa Secure cookie, HSTS y CORS estricto.
ENV=production

# ── Seguridad ─────────────────────────────────────────────────────────────────
# Clave secreta HMAC para firmar tokens de sesión.
# Generar: python SMART_Validation/generate_keys.py --secret
AUTH_SECRET_KEY=

# Duración de la sesión en horas (default: 8)
AUTH_TOKEN_HOURS=8

# URL pública de Railway (sin barra final). Restringe qué origen puede
# hacer llamadas a la API. Obtener en Railway → tu proyecto → Settings → Domain.
ALLOWED_ORIGIN=https://tu-proyecto.up.railway.app

# ── Base de datos ─────────────────────────────────────────────────────────────
# Volumen persistente de Railway. Configurar en:
#   Railway → tu servicio → Volumes → Mount path: /data
# En local, omitir o apuntar a una carpeta local.
DATA_DIR=/data

# ── Usuarios administradores (hasta 5) ───────────────────────────────────────
# Generar hash: python SMART_Validation/generate_keys.py --hash
# Verificar:    python SMART_Validation/generate_keys.py --verify
# Roles válidos: admin | auditor | client

USER1_NAME=fbongiovanni
USER1_HASH=pbkdf2_sha256$260000$SALT_HEX$HASH_HEX
USER1_DISPLAY=Federico Bongiovanni
USER1_ROLE=admin
USER1_EMAIL=fbongiovanni@tu-dominio.com

USER2_NAME=lsantarenz
USER2_HASH=pbkdf2_sha256$260000$SALT_HEX$HASH_HEX
USER2_DISPLAY=Lucas Santarenz
USER2_ROLE=admin
USER2_EMAIL=lsantarenz@tu-dominio.com

# USER3_NAME=auditor
# USER3_HASH=pbkdf2_sha256$260000$SALT_HEX$HASH_HEX
# USER3_DISPLAY=Auditor Externo
# USER3_ROLE=auditor

# ── Notificaciones por email (Resend) ────────────────────────────────────────
# Registrarse gratis en resend.com (3.000 emails/mes gratis).
# Requiere verificar un dominio de envío en el panel de Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dirección "De" para los emails salientes.
# Debe ser un dominio verificado en tu cuenta de Resend.
FROM_EMAIL=validaciones@tu-dominio.com

# ── API de IA ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...
