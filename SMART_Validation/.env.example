# Gestor de Evidencias GxP — Variables de entorno
#
# USO LOCAL:
#   1. Copiar este archivo como .env
#   2. Completar AUTH_SECRET_KEY ejecutando: python generate_keys.py
#   3. Iniciar con INICIAR.bat o: python server.py
#
# RAILWAY:
#   Cargar estas variables en el panel Variables de tu servicio Railway.
#   NUNCA subir .env a git. El archivo .env está en .gitignore.
#
# ──────────────────────────────────────────────────────────────────

# OBLIGATORIO: clave secreta para firmar sesiones y tokens de autenticación.
# Generar con: python generate_keys.py   (mínimo 32 bytes de entropía)
AUTH_SECRET_KEY=

# Modo producción: habilita HTTPS-only cookies, HSTS, anti-scanner, CSP restringido.
# Railway: setear ENV=production  ← EXACTAMENTE este nombre, el código lo requiere así.
# Local:   dejar comentado (= false por defecto).
# ENV=production

# URL pública del servidor (Railway/Render/etc). Requerida para que el QR del móvil
# funcione desde internet. Ejemplo: https://smart-validation.up.railway.app
# PUBLIC_URL=

# Habilitar sync móvil en producción (por defecto solo activo en dev).
# Requiere también PUBLIC_URL. Setear ambos para usar el QR desde el celular.
# SYNC_ENABLED=true

# Clave HMAC para el audit trail del Validation Book. Si no se setea, usa AUTH_SECRET_KEY.
# Generar con: python generate_keys.py
# AUDIT_HMAC_KEY=

# ── Base de datos ────────────────────────────────────────────────────────────

# PostgreSQL (Railway managed): Railway lo setea automáticamente al agregar
# el plugin de PostgreSQL. Cuando DATABASE_URL está seteada, el sistema usa
# PostgreSQL; sin ella usa SQLite (solo para desarrollo local).
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Directorio de datos persistentes para SQLite + uploads.
# Solo relevante en modo SQLite (sin DATABASE_URL).
# Railway con PostgreSQL: no necesitás Volume ni DATA_DIR.
# Railway con SQLite:     setear DATA_DIR=/data y montar un Volume en /data.
# Local:                  dejar comentado (default: directorio padre del repo).
# DATA_DIR=/data

# ── Superadministrador ───────────────────────────────────────────────────────
# Username del único usuario que puede crear, modificar y eliminar otros usuarios.
# Al arrancar el servidor, ese usuario queda marcado como superadmin en la DB.
# Solo puede haber un superadmin. Cambiar requiere reiniciar el servidor.
SUPERADMIN_USERNAME=

# ── Alertas de seguridad por email ───────────────────────────────────────────
# Email que recibirá las alertas: login del superadmin, cuentas bloqueadas,
# nuevos usuarios creados, usuarios eliminados, login desde IP nueva.
# Si no se define, las alertas van al email del superadmin guardado en la DB.
# Requiere RESEND_API_KEY configurado para funcionar.
ALERT_EMAIL=

# ── Email (Resend) ────────────────────────────────────────────────────────────
# API key de Resend para envío de emails (alertas, notificaciones de revisión).
# Obtener en: https://resend.com/api-keys  (plan gratuito: 100 emails/día)
# RESEND_API_KEY=
# FROM_EMAIL=noreply@tu-dominio.com

# ── OPCIONAL: API key de Anthropic ───────────────────────────────────────────
# Necesaria solo para la generación automática de documentos GxP con IA.
# Sin esta key el generador IA queda deshabilitado; el resto funciona normal.
ANTHROPIC_API_KEY=

# ── Bridge con la Suite de Revisión y Firmas ─────────────────────────────────
# URL base del servicio Firmas (suite-revision-firmas/). Sin esto, "Enviar a Firmas"
# y "Traer comentarios" quedan deshabilitados; el resto funciona normal.
# Local:   http://localhost:8090 (o el puerto que uses para levantar Firmas en dev)
# Railway: https://<dominio-del-servicio-firmas>.up.railway.app
FIRMAS_BASE_URL=

# Debe tener el MISMO valor que BRIDGE_API_KEY en las env vars de Firmas.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
BRIDGE_API_KEY=
